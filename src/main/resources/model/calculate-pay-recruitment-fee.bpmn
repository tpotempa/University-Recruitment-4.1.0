        <di:waypoint x="215" y="170" />
        <di:waypoint x="270" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0ngs57a_di" bpmnElement="Flow_0ngs57a">
        <di:waypoint x="370" y="170" />
