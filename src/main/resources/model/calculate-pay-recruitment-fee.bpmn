        <dc:Bounds x="760" y="130" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1wt26dr_di" bpmnElement="Gateway_1wt26dr" isMarkerVisible="true">
        <dc:Bounds x="925" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0qm41w8_di" bpmnElement="Event_PaymentCompleted" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1032" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
